{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{frontend/**,backend/tests/**,node_modules/**,.git/**,**/*.test.py,__pycache__/**,**/*.pyc,.pytest_cache/**,.venv/**}"
    }
  }
}